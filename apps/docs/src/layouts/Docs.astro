---
import type { MarkdownHeading } from 'astro'
import MobileNav from '../components/MobileNav'
import NavLinks from '../components/NavLinks.astro'
import Base from './Base.astro'

const { frontmatter, headings = [] } = Astro.props as {
  frontmatter: Record<string, string>
  headings?: MarkdownHeading[]
}
const path = Astro.url.pathname.replace(/\/$/, '') || '/'
const sections = headings.filter((h) => h.depth === 2)
---
<Base title={frontmatter.title} description={frontmatter.description}>
  <aside class="fixed inset-y-0 left-0 hidden w-64 overflow-y-auto px-10 py-12 xl:block">
    <a href="/" class="flex items-center gap-2 font-medium">
      <img src="/images/logo.svg" alt="" class="size-4 dark:invert" />
      Lightbox
    </a>
    <NavLinks path={path} sections={sections} />
  </aside>
  <header class="mx-auto flex h-12 max-w-145.5 items-center justify-between px-4 xl:hidden">
    <a href="/" class="flex items-center gap-2 font-medium">
      <img src="/images/logo.svg" alt="" class="size-4 dark:invert" />
      Lightbox
    </a>
    <MobileNav client:media="(max-width: 1279px)">
      <NavLinks path={path} sections={sections} />
    </MobileNav>
  </header>
  <main class="mx-auto max-w-145.5 px-4 pt-6 pb-16 xl:pt-24">
    <div class="flex items-baseline justify-between gap-4">
      <h1 class="font-medium">{frontmatter.title}</h1>
      <a href={`${path}.md`} class="shrink-0 text-muted transition-colors hover:text-ink">View as Markdown</a>
    </div>
    <article class="doc mt-4">
      {frontmatter.description && <p>{frontmatter.description}</p>}
      <slot />
    </article>
  </main>
</Base>
