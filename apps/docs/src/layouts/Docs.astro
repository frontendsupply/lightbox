---
import Base from './Base.astro'
import Header from '../components/Header.astro'
const { frontmatter } = Astro.props
const nav = [
  { title: 'Guide', links: [
    ['Getting started', '/docs'],
    ['Gestures', '/docs/gestures'],
    ['Styling', '/docs/styling'],
    ['API reference', '/docs/api'],
  ] },
  { title: 'Examples', links: [
    ['Feed', '/docs/examples/feed'],
    ['Listing', '/docs/examples/listing'],
    ['Stories', '/docs/examples/stories'],
  ] },
]
const path = Astro.url.pathname.replace(/\/$/, '') || '/'
---
<Base title={frontmatter.title} description={frontmatter.description}>
  <Header />
  <div class="mx-auto flex max-w-6xl gap-10 px-4 sm:px-6">
    <aside class="sticky top-14 hidden h-[calc(100dvh-3.5rem)] w-48 shrink-0 overflow-y-auto py-10 md:block">
      {nav.map((group) => (
        <div class="mb-8">
          <p class="mb-2 text-xs font-medium tracking-wide text-neutral-400 uppercase">{group.title}</p>
          <ul class="space-y-1">
            {group.links.map(([label, href]) => (
              <li>
                <a href={href} class:list={['block rounded-md py-1 text-sm transition-colors', path === href ? 'font-medium text-neutral-950 dark:text-white' : 'text-neutral-500 hover:text-neutral-900 dark:hover:text-neutral-200']}>{label}</a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </aside>
    <main class="min-w-0 flex-1 py-10">
      <nav class="mb-8 flex gap-4 overflow-x-auto text-sm whitespace-nowrap [scrollbar-width:none] md:hidden">
        {nav.flatMap((g) => g.links).map(([label, href]) => (
          <a href={href} class:list={[path === href ? 'font-medium' : 'text-neutral-500']}>{label}</a>
        ))}
      </nav>
      <article class="prose prose-neutral max-w-3xl dark:prose-invert prose-headings:font-semibold prose-headings:tracking-tight prose-a:underline-offset-4 prose-code:font-normal prose-code:before:content-none prose-code:after:content-none prose-table:text-sm">
        <h1>{frontmatter.title}</h1>
        {frontmatter.description && <p class="lead">{frontmatter.description}</p>}
        <slot />
      </article>
    </main>
  </div>
</Base>
