---
import type { MarkdownHeading } from 'astro'
import Base from './Base.astro'
const { frontmatter, headings = [] } = Astro.props as { frontmatter: Record<string, string>; headings?: MarkdownHeading[] }
const nav = [
  { title: 'Guide', links: [
    ['Getting started', '/docs'],
    ['Gestures', '/docs/gestures'],
    ['Styling', '/docs/styling'],
    ['API reference', '/docs/api'],
  ] },
  { title: 'Examples', links: [
    ['Feed', '/docs/examples/feed'],
    ['Listing', '/docs/examples/listing'],
    ['Stories', '/docs/examples/stories'],
  ] },
]
const path = Astro.url.pathname.replace(/\/$/, '') || '/'
const sections = headings.filter((h) => h.depth === 2)
const link = (href: string) => ['transition-colors hover:text-ink', path === href ? 'text-ink' : 'text-muted']
---
<Base title={frontmatter.title} description={frontmatter.description}>
  <aside class="fixed inset-y-0 left-0 hidden w-64 overflow-y-auto px-10 py-12 xl:block">
    <a href="/" class="flex items-center gap-2 font-medium">
      <img src="/images/logo.svg" alt="" class="size-4 dark:invert" />
      Lightbox
    </a>
    {nav.map((group) => (
      <div class="mt-8">
        <p class="font-medium">{group.title}</p>
        <ul class="mt-1.5 space-y-1">
          {group.links.map(([label, href]) => (
            <li>
              <a href={href} class:list={link(href)}>{label}</a>
              {path === href && sections.length > 0 && (
                <ul class="mt-1 mb-2 space-y-1 border-l border-line pl-3">
                  {sections.map((h) => <li><a href={`#${h.slug}`} class="text-muted transition-colors hover:text-ink">{h.text}</a></li>)}
                </ul>
              )}
            </li>
          ))}
        </ul>
      </div>
    ))}
  </aside>
  <main class="mx-auto max-w-[582px] px-4 pt-10 pb-32 sm:pt-24">
    <nav class="mb-12 flex flex-wrap gap-x-4 gap-y-1 xl:hidden">
      <a href="/" class="font-medium">Lightbox</a>
      {nav.flatMap((g) => g.links).map(([label, href]) => <a href={href} class:list={link(href)}>{label}</a>)}
    </nav>
    <h1 class="font-medium">{frontmatter.title}</h1>
    <article class="doc mt-4">
      {frontmatter.description && <p>{frontmatter.description}</p>}
      <slot />
    </article>
  </main>
</Base>
