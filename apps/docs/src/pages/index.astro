---
import Code from '../components/Code.astro'
import Hero from '../components/demos/Hero.tsx'
import Base from '../layouts/Base.astro'

const features = [
  [
    'Morph, not fade',
    'The thumbnail grows into the photo and un-crops on the way. Rounded corners, object-fit and object-position included.',
  ],
  ['Real scroll physics', 'Swiping is a native scroll-snap scroller, so touch and trackpad get the OS’s own momentum.'],
  ['Pinch, wheel, double-tap', 'Zoom follows your fingers, rubber-bands at the limits, and pans with inertia.'],
  ['Pull to dismiss', 'Drag the photo away; the backdrop fades with you and a flick carries its velocity home.'],
  [
    'The page keeps up',
    'Navigate inside the viewer and the page behind scrolls along, so closing lands on the right thumbnail.',
  ],
  [
    'Zero opinions',
    'No CSS ships. Style every part with Tailwind, CSS modules or anything else, via data attributes and a CSS variable.',
  ],
]

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareSourceCode',
  name: 'Lightbox',
  description:
    'A headless React lightbox and image viewer with pinch zoom, swipe and pull to dismiss. Built on Base UI and Motion.',
  url: Astro.site?.href,
  codeRepository: 'https://www.npmjs.com/package/@frontendsupply/lightbox',
  programmingLanguage: ['TypeScript', 'JavaScript'],
  runtimePlatform: 'Web browser',
  license: 'https://opensource.org/licenses/MIT',
  author: { '@type': 'Organization', name: 'Frontend Supply', url: 'https://frontend.supply' },
}
---
<Base>
  <script is:inline slot="head" type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <main class="mx-auto max-w-145.5 px-4 pt-10 pb-16 sm:pt-24">
    <nav class="flex items-center gap-4">
      <a href="/" class="mr-auto flex items-center gap-2 font-medium">
        <img src="/images/logo.svg" alt="" class="size-4 dark:invert" />
        Lightbox
      </a>
      <a href="/docs" class="text-muted transition-colors hover:text-ink">Docs</a>
      <a href="/docs/examples/chat" class="text-muted transition-colors hover:text-ink">Examples</a>
      <a href="/agent" class="text-muted transition-colors hover:text-ink">Agent</a>
    </nav>

    <article class="doc mt-12">
      <h1 class="font-medium">Everything a React lightbox should do.</h1>
      <p>Native gestures out of the box. The design is entirely up to you. A headless React lightbox and image viewer with pinch zoom, swipe and pull to dismiss, built on <a href="https://base-ui.com" target="_blank" rel="noreferrer">Base UI</a> and <a href="https://motion.dev" target="_blank" rel="noreferrer">Motion</a>.</p>
      <div class="demo">
        <Hero client:load />
        <p class="mt-3 text-center text-xs text-muted">Click any image. Swipe, pinch or scroll to zoom, pull to dismiss.</p>
      </div>

      <h2>Install</h2>
      <Code code="pnpm add @frontendsupply/lightbox @base-ui/react motion" lang="bash" />
      <p>Then follow <a href="/docs">Getting started</a>.</p>

      <h2>Features</h2>
      <div class="grid gap-x-8 gap-y-5 sm:grid-cols-2">
        {features.map(([title, body]) => (
          <div>
            <h3 class="font-medium">{title}</h3>
            <p class="mt-0.5 text-muted">{body}</p>
          </div>
        ))}
      </div>
    </article>
  </main>
</Base>
